<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.sandboxdaily.editor-agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string><string>-lc</string>
    <string>cd "$HOME/Desktop/ssnn-outputs/editor-agent" &amp;&amp; /opt/homebrew/bin/npm start</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>300</integer>
  <key>StandardOutPath</key><string>/tmp/editor-agent.log</string>
  <key>StandardErrorPath</key><string>/tmp/editor-agent.err.log</string>
</dict>
</plist>
